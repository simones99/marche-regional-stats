model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dPopulation","fEnrollments","dGDP","dDeaths","dUnemployment Rate","dUnemployment Rate (National & EU)"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Year
ref table 'ISCED 11'
ref table dPopulation
ref table fEnrollments
ref table dGDP
ref table Entities
ref table dDeaths
ref table 'dUnemployment Rate'

ref cultureInfo en-US

