	column Population
		dataType: int64
		formatString: 0
		lineageTag: 1fe205d7-5a71-427d-b1f0-f66e5646628b
		summarizeBy: sum
		sourceColumn: Population

		annotation SummarizationSetBy = Automatic

	column 'Age (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('dPopulation'[Age]),
				"(Blank)",
				'dPopulation'[Age] IN {"From 5 to 9 years",
					"Less than 5 years"},
				"0-9",
				'dPopulation'[Age] IN {"From 10 to 14 years",
					"From 15 to 19 years"},
				"10-19",
				'dPopulation'[Age] IN {"From 20 to 24 years",
					"From 25 to 29 years"},
				"20-29",
				'dPopulation'[Age] IN {"From 30 to 34 years",
					"From 35 to 39 years"},
				"30-39",
				'dPopulation'[Age] IN {"From 40 to 44 years",
					"From 45 to 49 years"},
				"40-49",
				'dPopulation'[Age] IN {"From 50 to 54 years",
					"From 55 to 59 years"},
				"50-59",
				'dPopulation'[Age] IN {"From 60 to 64 years",
					"From 65 to 69 years"},
				"60-69",
				'dPopulation'[Age] IN {"From 70 to 74 years",
					"From 75 to 79 years"},
				"70-79",
				'dPopulation'[Age] IN {"80 years or over"},
				"80+",
				'dPopulation'[Age] IN {"Total"},
				"Total",
				'dPopulation'[Age] IN {"Unknown"},
				"Unknown",
				'dPopulation'[Age]
			)
		lineageTag: e5854fba-6f60-4e9b-8cb5-c79d1169380b
		summarizeBy: none

