		formatString: 0
		lineageTag: 991c0e65-1a1a-4435-8087-22f64374b5b4
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column GDP
		dataType: double
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: 33c563e7-e198-4c0d-b3a1-b2610fa15fb5
		summarizeBy: sum
		sourceColumn: GDP

		annotation SummarizationSetBy = Automatic

