table dGDP
	lineageTag: 210598d1-6b12-42c1-ba50-d7816bdaef06

	measure 'GDP per Capita' =
			
			VAR GDPvalue =
			    SUM ( dGDP[GDP] )
			VAR PopValue =
			    CALCULATE (
			        SUM ( dPopulation[Population] ),
			        dPopulation[Age (groups)] = "Total",
			        dPopulation[Sex] = "Total"
			    )
			RETURN
			    DIVIDE ( GDPvalue, PopValue )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: 7556267b-3467-42ce-a9fc-92fe1607418d

	measure 'GDP per Capita Italy' =
			
			CALCULATE (
			    [GDP per Capita],
			    Entities[Entity] = "Italy"
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: a5d270b7-35c9-4cb8-9932-22faa63f7abf

	measure 'GDP per Capita EU' =
			
			CALCULATE (
			    [GDP per Capita],
			    Entities[Entity] = "European Union - 27 countries (from 2020)"
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: a9f36820-13fa-47b3-8bd2-7811347b4695

	measure 'GDP per Capita vs Italy' =
			
			DIVIDE ( [GDP per Capita] - [GDP per Capita Italy], [GDP per Capita Italy] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 52b7989e-3834-48c9-8a80-ae8d238c75ed

	measure 'GDP per Capita vs EU' =
			
			DIVIDE ( [GDP per Capita] - [GDP per Capita EU], [GDP per Capita EU] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f453259a-0ee8-4a4e-a2fe-86498034455e

	measure 'GDP per Capita vs Marche (Last 5 Years)' =
			
			-- Fino all'ultimo anno con PIL, così PIL e popolazione coprono gli stessi anni
			VAR MaxYear = MIN ( MAX ( 'Year'[Year] ), CALCULATE ( MAX ( dGDP[Year] ), REMOVEFILTERS () ) )
			-- Popolazione e PIL regione
			VAR GDPRegion =
			    CALCULATE (
			        SUM ( dGDP[GDP] ),
			        dGDP[Year] >= MaxYear - 4 && dGDP[Year] <= MaxYear
			    )
			VAR PopRegion =
			    CALCULATE (
			        SUM ( dPopulation[Population] ),
			        dPopulation[Year] >= MaxYear - 4 && dPopulation[Year] <= MaxYear,
			        dPopulation[Age (groups)] = "Total",
			        dPopulation[Sex] = "Total"
			    )
			VAR GDPpcRegion = DIVIDE ( GDPRegion, PopRegion )
			-- Popolazione e PIL Marche
			VAR GDPMarche =
			    CALCULATE (
			        SUM ( dGDP[GDP] ),
			        Entities[Entity] = "Marche",
			        dGDP[Year] >= MaxYear - 4 && dGDP[Year] <= MaxYear
			    )
			VAR PopMarche =
			    CALCULATE (
			        SUM ( dPopulation[Population] ),
			        Entities[Entity] = "Marche",
			        dPopulation[Year] >= MaxYear - 4 && dPopulation[Year] <= MaxYear,
			        dPopulation[Age (groups)] = "Total",
			        dPopulation[Sex] = "Total"
			    )
			VAR GDPpcMarche = DIVIDE ( GDPMarche, PopMarche )
			-- Differenza %
			RETURN
			    DIVIDE ( GDPpcRegion - GDPpcMarche, GDPpcMarche )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: cee57981-2c58-4fb7-843c-a3205c5665e0

	column Entity
		dataType: string
		lineageTag: 943d94a9-c44c-4e6a-8bb1-a2ee1f634286
