				    #"Removed Other Columns" = Table.SelectColumns(#"Changed Type",{"geo", "TIME_PERIOD", "OBS_VALUE"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Other Columns",{{"geo", "Entity"}, {"TIME_PERIOD", "Year"}, {"OBS_VALUE", "GDP"}}),
				    #"Filtered Rows1" = Table.SelectRows(#"Renamed Columns", each [Entity] = "Marche" or [Entity] = "Emilia-Romagna" or [Entity] = "Umbria" or [Entity] = "Toscana" or [Entity] = "Abruzzo" or [Entity] = "Lazio" or [Entity] = "Italy" or Text.Contains([Entity], "European Union")),
				    #"Multiplied Column" = Table.TransformColumns(#"Filtered Rows1", {{"GDP", each _ * 1000000, type number}})
				in
				    #"Multiplied Column"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

