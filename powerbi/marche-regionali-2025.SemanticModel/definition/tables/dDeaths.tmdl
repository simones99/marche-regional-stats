table dDeaths
	lineageTag: de7faa79-4e29-45aa-8490-0e77896a1493

	measure Dts_11_30 = ```
			
			    DIVIDE([Last_Number_of_Deaths_10-29], [Most_Recent_Total_Deaths])
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9b6610b5-83f5-4ba6-bf6e-f5cb6f514e24

	measure Last_Number_of_Deaths_10-29 = ```
			
			VAR MaxYear = 
			    MAX('dDeaths'[Year])
			VAR Last_Number_of_Males_10_29 = 
			    CALCULATE(
			        SUM('dDeaths'[Deaths]),
			        'dDeaths'[Year] = MaxYear,
			        'dDeaths'[Sex] = "M",
			        'dDeaths'[Age (groups)] = "10-19" ||
			        'dDeaths'[Age (groups)] = "20-29"
			     )
			VAR Last_Number_of_Females_10_29 = 
			    CALCULATE(
			        SUM('dDeaths'[Deaths]),
			        'dDeaths'[Year] = MaxYear,
			        'dDeaths'[Sex] = "F",
			        'dDeaths'[Age (groups)] = "10-19" ||
			        'dDeaths'[Age (groups)] = "20-29"
			     )
			RETURN Last_Number_of_Males_10_29 + Last_Number_of_Females_10_29
			```
		formatString: 0
		lineageTag: f592f9e5-7b6e-4706-a623-ea90785fb81e

	measure Last_Number_of_Deaths_Under_10 = ```
			
			VAR MaxYear = 
			    MAX('dDeaths'[Year])
			VAR Last_Number_of_Males_Under_10 = 
			    CALCULATE(
			        SUM('dDeaths'[Deaths]),
			        'dDeaths'[Year] = MaxYear,
			        'dDeaths'[Sex] = "M",
			        'dDeaths'[Age (groups)] = "0-9"
			    )
			VAR Last_Number_of_Females_Under_10 = 
			    CALCULATE(
			        SUM('dDeaths'[Deaths]),
			        'dDeaths'[Year] = MaxYear,
			        'dDeaths'[Sex] = "F",
			        'dDeaths'[Age (groups)] = "0-9"
			    )
			RETURN Last_Number_of_Males_Under_10 + Last_Number_of_Females_Under_10
			```
		formatString: 0
		lineageTag: 92ab9886-2056-4d81-9d8b-3dd425f88c37

	measure LT11_Dts = ```
			
			    DIVIDE([Last_Number_of_Deaths_Under_10], [Most_Recent_Total_Deaths])
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b3d5003f-1639-423b-b46e-e66af5045241

	measure Most_Recent_Total_Deaths =
			
			VAR MaxYear =
			    MAX('dDeaths'[Year])
			VAR FemaleDts =
			    CALCULATE(
			        SUM('dDeaths'[Deaths]),
			        'dDeaths'[Year] = MaxYear,
			        'dDeaths'[Sex] = "F",
			        'dDeaths'[Age (groups)] = "Total"
			    )
			VAR MaleDts =
			    CALCULATE(
			        SUM('dDeaths'[Deaths]),
			        'dDeaths'[Year] = MaxYear,
			        'dDeaths'[Sex] = "M",
			        'dDeaths'[Age (groups)] = "Total"
			    )
			RETURN
			    FemaleDts + MaleDts
		lineageTag: f7e5477c-4d5d-41a4-8d9c-7adc07b22be6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Deaths_Last_5_Years =
			
			VAR MaxYear =
			    MAX ( dDeaths[Year] )
			RETURN
			    CALCULATE (
			        SUM ( dDeaths[Deaths] ),
			        dDeaths[Age (groups)] = "Total",
			        dDeaths[Year] >= MaxYear - 4
			            && dDeaths[Year] <= MaxYear
			    )
		formatString: 0
		lineageTag: 3b60671d-5e22-462c-9b9d-6c812e6750a3

	measure Mortality_Rate =
			
			DIVIDE (
			    CALCULATE (
			        SUM ( dDeaths[Deaths] ),
			        dDeaths[Age (groups)] = "Total",
			        dDeaths[Sex] = "Total"
			    ),
			    CALCULATE (
			        SUM ( dPopulation[Population] ),
			        dPopulation[Age (groups)] = "Total",
			        dPopulation[Sex] = "Total"
			    )
			)
		lineageTag: da7d001d-1c4e-4b17-a628-1d9d659bf49c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Mortality_Rate_Last_5_Years_Weighted =
			
			VAR MaxYear =
			    MAX ( dDeaths[Year] )
			VAR Deaths5Y =
			    CALCULATE (
			        SUM ( dDeaths[Deaths] ),
			        dDeaths[Age (groups)] = "Total",
			        dDeaths[Sex] = "Total",
			        dDeaths[Year] >= MaxYear - 4
			            && dDeaths[Year] <= MaxYear
			    )
			VAR Pop5Y =
			    CALCULATE (
			        SUM ( dPopulation[Population] ),
			        dPopulation[Age (groups)] = "Total",
			        dPopulation[Sex] = "Total",
			        dPopulation[Year] >= MaxYear - 4
			            && dPopulation[Year] <= MaxYear
			    )
			RETURN
			    DIVIDE ( Deaths5Y, Pop5Y )
		formatString: 0.000%;-0.000%;0.000%
		lineageTag: 37074fdb-842a-4111-8966-9b0f5aa1b837

