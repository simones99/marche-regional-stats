table 'dUnemployment Rate'
	lineageTag: eaf49ad4-8c5f-49c6-9f14-9d62aa068880

	measure 'Unemployment Rate Italy' =
			CALCULATE(
			    AVERAGE('dUnemployment Rate'[UnemploymentRate]),
			    'dUnemployment Rate'[Entity] = "Italy"
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4b239103-4911-419f-9118-3817265d79e2

	measure 'Unemployment Rate Marche' =
			CALCULATE(
			    AVERAGE('dUnemployment Rate'[UnemploymentRate]),
			    'dUnemployment Rate'[Entity] = "Marche"
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d40fc6a6-df5c-4144-b77a-151d0341ca0f

	measure 'Unemployment Rate EU' =
			CALCULATE(
			    AVERAGE('dUnemployment Rate'[UnemploymentRate]),
			    'dUnemployment Rate'[Entity] = "European Union - 27 countries (from 2020)"
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6e9a1397-7dc1-41f4-a618-de8afd568593

	measure 'Unemployment Rate vs Italy' =
			DIVIDE(
			    [Unemployment Rate Marche] - [Unemployment Rate Italy],
			    [Unemployment Rate Italy])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d3b73379-cc7d-4417-8ca9-c1b6f8e3845c

	measure 'Unemployment Rate vs EU' =
			DIVIDE(
			    [Unemployment Rate Marche] - [Unemployment Rate EU],
			    [Unemployment Rate EU])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6f6e021b-d288-4739-a232-2673ec1e89e2

	measure 'Unemployment Rate vs Marche (Last 5 Years)' =
			
			VAR MaxYear = MAX ( 'Year'[Year] )
			-- Disoccupazione regione (5 anni)
			VAR UnemploymentRegion =
			    CALCULATE (
			        AVERAGE( 'dUnemployment Rate'[UnemploymentRate]),
			        'dUnemployment Rate'[Year] >= MaxYear - 4 && 'dUnemployment Rate'[Year] <= MaxYear
			    )
			-- Disoccupazione Marche (5 anni)
			VAR UnemploymentMarche =
			    CALCULATE (
			        AVERAGE( 'dUnemployment Rate'[UnemploymentRate]),
			        Entities[Entity] = "Marche",
			       'dUnemployment Rate'[Year] >= MaxYear - 4 && 'dUnemployment Rate'[Year] <= MaxYear
			    )
			-- Differenza %
			RETURN
			    DIVIDE ( UnemploymentRegion - UnemploymentMarche, UnemploymentMarche )
		formatString: 0%;-0%;0%
		lineageTag: 25d4de98-fa31-4f1a-ae56-7ddf1ffe7b28

	column Entity
		dataType: string
		lineageTag: dfeeee45-fb81-4e03-93d0-16321e942ff9
		summarizeBy: none
		sourceColumn: Entity

		annotation SummarizationSetBy = Automatic

	column Year
		dataType: int64
		formatString: 0
		lineageTag: b2a7f218-5525-4bd6-8fd4-bfbb31d00963
		summarizeBy: none
		sourceColumn: Year

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column UnemploymentRate
		dataType: double
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 09aeae94-acfb-444f-bba1-8d9d5716a1ac
		summarizeBy: sum
		sourceColumn: UnemploymentRate

		annotation SummarizationSetBy = Automatic

