                "textRuns": [
                  {
                    "value": "The population of the Marche region has undergone important demographic changes over the past two decades. After a steady increase from 2000, peaking at around ",
                    "textStyle": {
                      "fontSize": "10.5pt"
                    }
                  },
                  {
                    "value": "1.55 million residents between 2010 and 2012",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt"
                    }
                  },
                  {
                    "value": ", the trend reversed and the population has been ",
                    "textStyle": {
                      "fontSize": "10.5pt"
                    }
                  },
                  {
                    "value": "declining since 2015",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt"
                    }
                  },
                  {
                    "value": ". By 2024, the total population had fallen to approximately ",
                    "textStyle": {
                      "fontSize": "10.5pt"
                    }
                  },
                  {
                    "value": "1.48 million",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10.5pt"
                    }
                  },
                  {
                    "value": ", returning to early 2000s levels.",
                    "textStyle": {
                      "fontSize": "10.5pt"
                    }
                  }
                ]
              }
            ]
          }
        }
