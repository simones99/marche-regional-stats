table dPopulation
	lineageTag: 8ce83a7f-5b25-4dee-b54a-e2c5146205f3

	measure 'Most Recent Total Population' =
			
			VAR MaxYear =
			    MAX(dPopulation[Year])
			VAR FemalePop =
			    CALCULATE (
			        SUM (dPopulation[Population]),
			        dPopulation[Sex] = "F",
			        dPopulation[Age] = "TOTAL",
			        dPopulation[Year] = MaxYear
			    )
			VAR MalePop =
			    CALCULATE (
			        SUM (dPopulation[Population]),
			        dPopulation[Sex] = "M",
			        dPopulation[Age] = "TOTAL",
			        dPopulation[Year] = MaxYear
			    )
			RETURN
			    FemalePop + MalePop
		formatString: #,0
		lineageTag: f4536e98-6ae0-4437-826c-6375b422152c

	measure Last_Number_of_Over_65 = ```
			
			    VAR MaxYear = 
			        MAX('dPopulation'[Year])
			    VAR Last_Number_of_Males_Over_65 = 
			        CALCULATE(
			            SUM('dPopulation'[Population]),
			            'dPopulation'[Year] = MaxYear,
			            'dPopulation'[Sex] = "M",
			            'dPopulation'[Age] == "65+"
			        )
			     VAR Last_Number_of_Females_Over_65 = 
			        CALCULATE(
			            SUM('dPopulation'[Population]),
			            'dPopulation'[Year] = MaxYear,
			            'dPopulation'[Sex] = "F",
			            'dPopulation'[Age] == "65+"
			        )
			    RETURN Last_Number_of_Males_Over_65 + Last_Number_of_Females_Over_65
			
			
			```
		formatString: 0
		lineageTag: 67c0613b-f6ff-41a3-93af-38086614c4a7

	measure Percentage_of_Under_15 = ```
			
			    DIVIDE([Last_Number_of_Under_15], [Most Recent Total Population])
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c2c83985-5828-4bd3-a291-21da8f3e4e29

	measure Last_Number_of_Under_15 = ```
			
			    VAR MaxYear = 
			        MAX('dPopulation'[Year])
			    VAR Last_Number_of_Males_Under_15 = 
			        CALCULATE(
			            SUM('dPopulation'[Population]),
			            'dPopulation'[Year] = MaxYear,
			            'dPopulation'[Sex] = "M",
			            'dPopulation'[Age] == "0-15"
			        )
			     VAR Last_Number_of_Females_Under_15 = 
			        CALCULATE(
			            SUM('dPopulation'[Population]),
			            'dPopulation'[Year] = MaxYear,
			            'dPopulation'[Sex] = "F",
			            'dPopulation'[Age] == "0-15"
			        )
			    RETURN Last_Number_of_Males_Under_15 + Last_Number_of_Females_Under_15
			
			
			```
		formatString: 0
		lineageTag: bfcd9d27-627b-4ed1-b45f-972b9a131bd0

	measure Percentage_of_Over_65 = ```
			
			    DIVIDE([Last_Number_of_Over_65], [Most Recent Total Population])
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 64738588-26b0-4c33-8f1e-92cd987515bc

