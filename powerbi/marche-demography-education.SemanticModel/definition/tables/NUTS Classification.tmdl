	partition 'NUTS Classification' = m
		mode: import
		source =
				let
				    // NUTS 2024 attribute table from GISCO; the NUTS level is the code length minus the 2-letter country code
				    Source = Csv.Document(Web.Contents("https://gisco-services.ec.europa.eu/distribution/v2/nuts/csv/NUTS_AT_2024.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Removed Other Columns" = Table.SelectColumns(#"Promoted Headers",{"NUTS_ID", "NAME_LATN"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Other Columns",{{"NUTS_ID", "NUTS Code"}, {"NAME_LATN", "NUTS label"}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{{"NUTS Code", type text}, {"NUTS label", type text}}),
				    #"Added NUTS level" = Table.AddColumn(#"Changed Type", "NUTS level", each Text.Length([NUTS Code]) - 2, Int64.Type),
				    #"Filtered Rows" = Table.SelectRows(#"Added NUTS level", each [NUTS level] = #"NUTS Level"),
				    #"Filtered Rows2" = Table.SelectRows(#"Filtered Rows", each Text.Contains([NUTS Code], #"Code of Interest"))
				in
				    #"Filtered Rows2"

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

