	column Deaths
		dataType: int64
		formatString: 0
		lineageTag: 0ba5efc5-e20f-46b3-9ade-17bb8bf8016c
		summarizeBy: sum
		sourceColumn: Deaths

		annotation SummarizationSetBy = Automatic

	column 'Age (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('dMortality'[Age]),
				"(Blank)",
				'dMortality'[Age] IN {"From 10 to 14 years",
					"From 5 to 9 years",
					"Less than 5 years"},
				"0-15",
				'dMortality'[Age] IN {"From 15 to 19 years",
					"From 20 to 24 years",
					"From 25 to 29 years",
					"From 30 to 34 years",
					"From 35 to 39 years",
					"From 40 to 44 years",
					"From 45 to 49 years",
					"From 50 to 54 years",
					"From 55 to 59 years",
					"From 60 to 64 years"},
				"15-64",
				'dMortality'[Age] IN {"90 years or over",
					"From 65 to 69 years",
					"From 70 to 74 years",
					"From 75 to 79 years",
					"From 80 to 84 years",
					"From 85 to 89 years"},
				"65+",
				'dMortality'[Age] IN {"Total"},
				"Total",
				'dMortality'[Age] IN {"Unknown"},
				"Unknown",
				'dMortality'[Age]
			)
		lineageTag: 7a2236ed-cfc7-4dd8-b8b7-d579324c58a0
		summarizeBy: none

