table dMortality
	lineageTag: 2c30ae91-a863-4ed8-b9f5-5fd002a4f84c

	measure 'Most Recent Total Deaths' =
			
			VAR MaxYear =
			    MAX(dMortality[Year])
			VAR FemaleDts =
			    CALCULATE (
			        SUM (dMortality[Deaths]),
			        dMortality[Year] = MaxYear,
			        dMortality[Sex] = "F",
			        dMortality[Age (groups)] = "Total"
			    )
			VAR MaleDts =
			    CALCULATE (
			        SUM (dMortality[Deaths]),
			        dMortality[Year] = MaxYear,
			        dMortality[Sex] = "M",
			        dMortality[Age (groups)] = "Total"
			    )
			RETURN
			    FemaleDts + MaleDts
		formatString: 0
		lineageTag: f7e5477c-4d5d-41a4-8d9c-7adc07b22be6

	measure Last_Number_of_Deaths_Under_15 = ```
			
			    VAR MaxYear = 
			        MAX('dMortality'[Year])
			    VAR Last_Number_of_Males_Under_15 = 
			        CALCULATE(
			            SUM('dMortality'[Deaths]),
			            'dMortality'[Year] = MaxYear,
			            'dMortality'[Sex] = "M",
			            'dMortality'[Age (groups)] == "0-15"
			        )
			     VAR Last_Number_of_Females_Under_15 = 
			        CALCULATE(
			            SUM('dMortality'[Deaths]),
			            'dMortality'[Year] = MaxYear,
			            'dMortality'[Sex] = "F",
			            'dMortality'[Age (groups)] == "0-15"
			        )
			    RETURN Last_Number_of_Males_Under_15 + Last_Number_of_Females_Under_15
			
			
			```
		formatString: 0
		lineageTag: 92ab9886-2056-4d81-9d8b-3dd425f88c37

	measure LT15_Dts = ```
			
			    DIVIDE([Last_Number_of_Deaths_Under_15], [Most Recent Total Deaths])
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b3d5003f-1639-423b-b46e-e66af5045241

	measure Last_Number_of_Deaths_15-24 = ```
			
			    VAR MaxYear = 
			        MAX('dMortality'[Year])
			    VAR Last_Number_of_Males_15_24 = 
			        CALCULATE(
			            SUM('dMortality'[Deaths]),
			            'dMortality'[Year] = MaxYear,
			            'dMortality'[Sex] = "M",
			            'dMortality'[Age] == "From 15 to 19 years" ||
			            'dMortality'[Age] == "From 20 to 24 years"
			         )
			     VAR Last_Number_of_Females_15_24 = 
			        CALCULATE(
			            SUM('dMortality'[Deaths]),
			            'dMortality'[Year] = MaxYear,
			            'dMortality'[Sex] = "F",
			            'dMortality'[Age] == "From 15 to 19 years" ||
			            'dMortality'[Age] == "From 20 to 24 years"
			         )
			    RETURN Last_Number_of_Males_15_24 + Last_Number_of_Females_15_24
			
			
			```
		formatString: 0
		lineageTag: f592f9e5-7b6e-4706-a623-ea90785fb81e

	measure Dts_15_24 = ```
			
			    DIVIDE([Last_Number_of_Deaths_15-24], [Most Recent Total Deaths])
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9b6610b5-83f5-4ba6-bf6e-f5cb6f514e24

