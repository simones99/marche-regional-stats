table fEnrollments
	lineageTag: c0ad9aef-92ef-4f64-9d10-f1e1086071e2

	measure 'Total Enrollments' = ```
			
			[Male Enrollments] + [Female Enrollments]
			
			```
		formatString: 0
		lineageTag: e565d048-ffc0-4ba8-9bd6-172aa500e57b

	measure 'Male Enrollments' =
			
			CALCULATE(
			    SUM('fEnrollments'[Enrollments]),
			    KEEPFILTERS('fEnrollments'[Sex] == "M")
			)
		formatString: 0
		lineageTag: a87e1a2d-6a36-406f-bc1e-fcf5c023947a

	measure 'Female Enrollments' =
			
			CALCULATE(
			    SUM('fEnrollments'[Enrollments]),
			    KEEPFILTERS('fEnrollments'[Sex] == "F")
			)
		formatString: 0
		lineageTag: 38f2e273-350c-4ab2-bf11-7e48832c408c

	column ISCED11
		dataType: string
		lineageTag: aa60ff2f-64eb-4a96-a258-4a2f0a4bab32
		summarizeBy: none
		sourceColumn: ISCED11

		annotation SummarizationSetBy = Automatic

	column Sex
