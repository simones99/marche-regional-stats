/// One row per indicator of the area and province tooltips. The tooltip table lists one
/// row per indicator, so its height does not depend on the length of the values.
table 'Tooltip indicator'
	lineageTag: 6941fe58-ae44-496e-8c9c-2a7311a519a9

	column Row
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1ca36beb-b439-4f43-8be5-5bf615fc6f91
		summarizeBy: none
		sourceColumn: [Row]

	column Indicator
		dataType: string
		lineageTag: 074a6893-b212-4d40-af85-807cbfefa790
		summarizeBy: none
		sourceColumn: [Indicator]
		sortByColumn: Row

	column InArea
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6d04160f-342d-44d3-9cad-ba45aae0a0a9
		summarizeBy: none
		sourceColumn: [InArea]

	column InProvince
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 01326aa6-77ea-4a32-98a4-a6b6ca5c858c
		summarizeBy: none
		sourceColumn: [InProvince]

	partition 'Tooltip indicator' = calculated
		mode: import
		source =
				DATATABLE (
				    "Row", INTEGER, "Indicator", STRING, "InArea", INTEGER, "InProvince", INTEGER,
				    {
				        { 1, "Population change, 5 years", 1, 1 },
				        { 2, "Aged 65+", 1, 1 },
				        { 3, "Deaths per 1,000", 1, 1 },
				        { 4, "Companies per 1,000", 0, 1 },
				        { 5, "GDP per inhabitant (EUR)", 1, 1 },
				        { 6, "Unemployment rate", 1, 0 },
				        { 7, "Tertiary students per 1,000", 1, 0 }
				    }
				)

