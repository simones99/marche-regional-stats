	/// Women in the age bands aged 65 and over (accent bars of the pyramid).
	measure 'Population (women aged 65+)' = CALCULATE ( [Population (women)], KEEPFILTERS ( AgeGroup[BroadGroup] = "65+" ) )
		formatString: #,0
		displayFolder: Report visuals
		lineageTag: 80f9a5c9-662f-4502-98e6-fcb724e5951c

	/// Women in the age bands under 65 (grey bars of the pyramid).
	measure 'Population (women under 65)' = CALCULATE ( [Population (women)], KEEPFILTERS ( AgeGroup[BroadGroup] <> "65+" ) )
		formatString: #,0
		displayFolder: Report visuals
