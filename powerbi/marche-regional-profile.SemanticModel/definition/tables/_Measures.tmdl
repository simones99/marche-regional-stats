	/// Men enrolled below the tertiary levels (grey bars of the butterfly chart).
	measure 'Students (men, other levels)' = CALCULATE ( [Students (men)], KEEPFILTERS ( ISCED[Group] <> "ISCED 5-8" ) )
		formatString: #,0
		displayFolder: Report visuals
