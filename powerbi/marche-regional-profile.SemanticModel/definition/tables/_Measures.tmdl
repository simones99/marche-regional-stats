	/// Women enrolled below the tertiary levels (grey bars of the butterfly chart).
	measure 'Students (women, other levels, negative)' = CALCULATE ( [Students (women, negative)], KEEPFILTERS ( ISCED[Group] <> "ISCED 5-8" ) )
		formatString: #,0;#,0
		displayFolder: Report visuals
