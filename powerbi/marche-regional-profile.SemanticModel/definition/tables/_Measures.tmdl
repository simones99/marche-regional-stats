	/// Women enrolled at the tertiary levels (accent bars of the butterfly chart).
	measure 'Students (women, tertiary, negative)' = CALCULATE ( [Students (women, negative)], KEEPFILTERS ( ISCED[Group] = "ISCED 5-8" ) )
		formatString: #,0;#,0
