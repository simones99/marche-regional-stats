	/// Men enrolled at the tertiary levels (accent bars of the butterfly chart).
	measure 'Students (men, tertiary)' = CALCULATE ( [Students (men)], KEEPFILTERS ( ISCED[Group] = "ISCED 5-8" ) )
		formatString: #,0
