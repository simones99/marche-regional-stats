/// Out-of-sample errors of SARIMA and the naive baselines (powerbi/data/forecast_accuracy.csv).
table ForecastAccuracy
	lineageTag: 6939f92d-3553-43a2-b771-4c24fe1edf9f

	column Method
		dataType: string
		lineageTag: e5545ff5-c01a-46eb-9bf4-1315e1fff613
		summarizeBy: none
		sourceColumn: Method

	column MAE
		dataType: double
		formatString: #,0
		lineageTag: e08dac7a-2666-4ece-9e97-d78c64b58e0d
		summarizeBy: none
		sourceColumn: MAE

	column MAPE
		dataType: double
		formatString: 0.00
		lineageTag: f7651f82-78c6-4673-88fe-fd84ce66043f
		summarizeBy: none
		sourceColumn: MAPE

	column Specification
		dataType: string
		lineageTag: ff9baf20-9022-4be8-8195-e479f2c24117
		summarizeBy: none
		sourceColumn: Specification

	column IntervalCoverage
		dataType: double
		formatString: 0
		lineageTag: 40ed00de-ea09-4309-a04c-f0b2363da4cd
		summarizeBy: none
		sourceColumn: IntervalCoverage

	column HoldoutStart
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: de4c2b13-bdc5-4ff6-81fc-e4e32482a17f
		summarizeBy: none
		sourceColumn: HoldoutStart

		annotation UnderlyingDateTimeDataType = Date

	column HoldoutEnd
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 4fb2f2cb-b839-4ade-9636-50447fd2fc32
		summarizeBy: none
		sourceColumn: HoldoutEnd

		annotation UnderlyingDateTimeDataType = Date

	partition ForecastAccuracy = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(RepoRawBase & "/powerbi/data/forecast_accuracy.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Renamed = Table.RenameColumns(Blanks, {
				        {"method", "Method"}, {"mae", "MAE"}, {"mape_pct", "MAPE"}, {"specification", "Specification"},
				        {"interval_coverage_pct", "IntervalCoverage"}, {"holdout_start", "HoldoutStart"}, {"holdout_end", "HoldoutEnd"}
				    }),
				    Typed = Table.TransformColumnTypes(Renamed, {
				        {"Method", type text}, {"MAE", type number}, {"MAPE", type number}, {"Specification", type text},
				        {"IntervalCoverage", type number}, {"HoldoutStart", type date}, {"HoldoutEnd", type date}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigazione

