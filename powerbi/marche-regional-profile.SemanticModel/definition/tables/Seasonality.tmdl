/// Average STL seasonal effect on active companies by calendar month
/// (powerbi/data/seasonality.csv, the profile of docs/results.md, section 3).
table Seasonality
	lineageTag: dae20a1f-678c-4677-a781-8936f5ce2645

	column Month
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4661577a-016f-4d62-9544-ac2ed312bf8e
		summarizeBy: none
		sourceColumn: Month

	column MonthName
		dataType: string
		lineageTag: 0b7dac0d-18da-475d-ae76-5bc58df75984
		summarizeBy: none
		sourceColumn: MonthName
		sortByColumn: Month

	column Effect
		dataType: double
		isHidden
		formatString: +#,0;-#,0;0
		lineageTag: d684229f-89ed-4ac0-bd9a-911ce4191b87
		summarizeBy: sum
		sourceColumn: Effect

	partition Seasonality = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(RepoRawBase & "/powerbi/data/seasonality.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Renamed = Table.RenameColumns(Promoted, {{"month", "Month"}, {"month_name", "MonthName"}, {"effect", "Effect"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Month", Int64.Type}, {"MonthName", type text}, {"Effect", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

