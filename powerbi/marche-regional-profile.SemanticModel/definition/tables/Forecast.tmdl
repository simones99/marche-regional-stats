/// Regional active companies: series the SARIMA model is fitted on, holdout forecasts and
/// the 12-month forecast with its 95 % interval (powerbi/data/forecast.csv).
table Forecast
	lineageTag: 9a3dd500-b31f-4841-a023-ae628901555b

	column Date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: fae29d60-4df2-43c8-962f-faae47dab302
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column Actual
		dataType: double
		isHidden
		formatString: #,0
		lineageTag: ccbcf37f-9174-44df-bca3-15585ba9be1a
		summarizeBy: sum
		sourceColumn: Actual

	column HoldoutSarima
		dataType: double
		isHidden
		formatString: #,0
		lineageTag: ec2c8b7b-ab6f-433d-9168-88b5d349b626
		summarizeBy: sum
		sourceColumn: HoldoutSarima

	column HoldoutNaive
		dataType: double
		isHidden
		formatString: #,0
		lineageTag: 0789a1f7-032a-4a24-a622-87ed1b719406
		summarizeBy: sum
		sourceColumn: HoldoutNaive

	column HoldoutSeasonalNaive
		dataType: double
		isHidden
		formatString: #,0
		lineageTag: 95ea7d72-5f57-46c2-a434-44ee3f2230ee
		summarizeBy: sum
		sourceColumn: HoldoutSeasonalNaive

	column Forecast
		dataType: double
		isHidden
		formatString: #,0
		lineageTag: e9177318-c605-46db-ad36-24beb4821867
		summarizeBy: sum
		sourceColumn: Forecast

	column Lower95
		dataType: double
		isHidden
		formatString: #,0
		lineageTag: 80055bc8-c5af-4787-a890-da13bda2a93b
		summarizeBy: sum
		sourceColumn: Lower95

	column Upper95
		dataType: double
		isHidden
		formatString: #,0
		lineageTag: 9ba75325-d628-4dc1-a75d-46eebab53dc1
		summarizeBy: sum
		sourceColumn: Upper95

	partition Forecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(RepoRawBase & "/powerbi/data/forecast.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Renamed = Table.RenameColumns(Blanks, {
				        {"date", "Date"}, {"actual", "Actual"}, {"holdout_sarima", "HoldoutSarima"}, {"holdout_naive", "HoldoutNaive"},
				        {"holdout_seasonal_naive", "HoldoutSeasonalNaive"}, {"forecast", "Forecast"}, {"lower_95", "Lower95"}, {"upper_95", "Upper95"}
				    }),
				    Typed = Table.TransformColumnTypes(Renamed, {
				        {"Date", type date}, {"Actual", type number}, {"HoldoutSarima", type number}, {"HoldoutNaive", type number},
				        {"HoldoutSeasonalNaive", type number}, {"Forecast", type number}, {"Lower95", type number}, {"Upper95", type number}
				    }, "en-US"),
				    // Calendar starts on 1 January of StartYear.
				    InRange = Table.SelectRows(Typed, each [Date] >= #date(StartYear, 1, 1))
				in
				    InRange

	annotation PBI_ResultType = Table

